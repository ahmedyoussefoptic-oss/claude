rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is an admin
    // NOTE: role values are stored/compared as 'ADMIN' (uppercase) everywhere
    // in the app (see src/config/roles.js) — this must match, or every
    // isAdmin() check below silently evaluates to false for real users.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // The caller's own staff profile doc, or null if signed out. Field
    // accessors below use get(key, default) so accounts created before the
    // access/perms schema existed don't error the rule out.
    function myDoc() {
      return isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    function myPerm(p) {
      return myDoc() != null && myDoc().get('perms', {}).get(p, false) == true;
    }
    function inMyScope(branch) {
      let u = myDoc();
      // `branches` (array) is the current multi-branch field; `branch`
      // (singular) is kept for accounts created before that existed.
      return u != null && (
        u.get('access', 'branch') == 'all' ||
        branch in u.get('branches', []) ||
        u.get('branch', null) == branch
      );
    }
    // Branch reception desk (role RECEPTIONIST): may only list the branch
    // QR visit records (complaints with viaVisitQr) — nothing else.
    function isReceptionist() {
      return myDoc() != null && myDoc().get('role', null) == 'RECEPTIONIST';
    }
    // Per-user access to the school trips section (Users page):
    // 'all' (default) — everything, 'tripsOnly' — only the trips section,
    // 'none' — everything except trips. Admins always see everything.
    function tripsAccess() {
      return myDoc() == null ? 'none' : (myDoc().get('role', null) == 'ADMIN' ? 'all' : myDoc().get('tripsAccess', 'all'));
    }
    function isTripsOnly() {
      return tripsAccess() == 'tripsOnly';
    }
    function canSeeTrips() {
      return isAuthenticated() && !isReceptionist() && tripsAccess() != 'none';
    }
    // System owner ("منشئ النظام", set only by the claimSystemOwner function)
    // always has every power; other ADMIN accounts have the capabilities the
    // owner leaves on in settings/adminPermissions (missing = allowed).
    function isOwner() {
      return myDoc() != null && myDoc().get('isOwner', false) == true;
    }
    function adminPerm(cap) {
      let p = /databases/$(database)/documents/settings/adminPermissions;
      return isOwner() || (isAdmin() && (!exists(p) || get(p).data.get(cap, true) == true));
    }
    // When the owner sets a Settings password (settings/security.lockEnabled),
    // writes to the settings collections need a fresh unlock written by the
    // unlockSettings function.
    function settingsUnlocked() {
      let lock = /databases/$(database)/documents/settings/security;
      let unlock = /databases/$(database)/documents/settingsUnlocks/$(request.auth.uid);
      return !exists(lock) || get(lock).data.get('lockEnabled', false) != true ||
        (exists(unlock) && get(unlock).data.expiresAt > request.time);
    }
    function canWriteSettings() {
      return adminPerm('settings') && settingsUnlocked();
    }
    function canEditRecord(branch) {
      return isAdmin() || (myPerm('edit') && inMyScope(branch));
    }
    function canDeleteRecord(branch) {
      return adminPerm('delete') || (!isAdmin() && myPerm('delete') && inMyScope(branch));
    }

    // Tech-support tickets hold national IDs and account credentials, so
    // that module is restricted to the IT department's own specialists,
    // admins, and Customer Service — they're the ones who take the
    // parent's call and log the ticket before it ever reaches IT.
    function canAccessTechSupport() {
      return isAdmin() ||
        (myDoc() != null && !isTripsOnly() && (
          myDoc().get('department', null) == 'IT' ||
          myDoc().get('role', null) == 'CUSTOMER_SERVICE' ||
          // School principals are auto-assigned every public-link ticket in
          // their branch (see findPublicAssignees in functions/index.js).
          myDoc().get('isPrincipal', false) == true ||
          // Quality officers are auto-assigned every complaint and ticket
          // in their branches (see findAutoAssignees).
          myDoc().get('isQuality', false) == true
        ));
    }

    // A narrow allowance for the public parent-tracking portal: an
    // unauthenticated parent may only touch the satisfaction-survey /
    // reopen fields on a complaint they already know the ID of — never
    // arbitrary fields.
    function isParentPortalUpdate() {
      let incoming = request.resource.data;
      let affected = incoming.diff(resource.data).affectedKeys();
      // Only reachable from a SOLVED complaint, and only into CLOSED (parent
      // satisfied) or IN_PROGRESS (parent reopened) — blocks an anonymous
      // caller from touching a complaint in any other state or setting an
      // arbitrary status (e.g. silently closing/hiding an open complaint).
      return resource.data.status == 'SOLVED' &&
        (incoming.status == 'CLOSED' || incoming.status == 'IN_PROGRESS') &&
        affected.hasOnly(['satisfactionRate', 'satisfactionDetails', 'parentFeedback', 'status', 'closedAt', 'reopened', 'updatedAt']);
    }

    // Same narrow shape as isParentPortalUpdate() above, generalized for the
    // lost & found / tech-support satisfaction surveys — each only reachable
    // from its own "awaiting the parent" status, into one of a small allowed
    // set of next statuses, touching only survey fields.
    function isParentSurveyUpdate(fromStatus, toStatuses, allowedFields) {
      let incoming = request.resource.data;
      let affected = incoming.diff(resource.data).affectedKeys();
      return resource.data.status == fromStatus &&
        incoming.status in toStatuses &&
        affected.hasOnly(allowedFields);
    }

    // A non-admin holding the "manage users" permission may never grant (to
    // anyone, including themselves) admin-equivalent power: the ADMIN role,
    // org-wide 'all' access, or the users-management permission itself.
    // Without this cap, perms.users was equivalent to full admin.
    function grantsAdminPower(data) {
      return data.role == 'ADMIN' ||
        data.get('access', 'branch') == 'all' ||
        data.get('perms', {}).get('users', false) == true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Admins may do anything. A "manage users" holder may only create or
      // touch OTHER staff accounts, may never grant admin-equivalent power,
      // and may never act on an existing admin's account.
      // isOwner is never written by a client, and the owner's account can
      // only be changed by the owner. Admin accounts are managed by the owner
      // or admins allowed to (adminPermissions.manageAdmins).
      allow create: if request.resource.data.get('isOwner', false) != true && (
        (adminPerm('users') && (request.resource.data.role != 'ADMIN' || adminPerm('manageAdmins'))) ||
        (!isAdmin() && myPerm('users') && !grantsAdminPower(request.resource.data))
      );
      allow delete: if resource.data.get('isOwner', false) != true && request.auth.uid != userId && (
        (adminPerm('users') && (resource.data.role != 'ADMIN' || adminPerm('manageAdmins'))) ||
        (!isAdmin() && myPerm('users') && resource.data.role != 'ADMIN')
      );
      allow update: if request.resource.data.get('isOwner', false) == resource.data.get('isOwner', false) && ((
        (resource.data.get('isOwner', false) != true || request.auth.uid == userId) &&
        adminPerm('users') &&
        ((resource.data.role != 'ADMIN' && request.resource.data.role != 'ADMIN') || adminPerm('manageAdmins') || request.auth.uid == userId)
      ) || (
        !isAdmin() && myPerm('users') && request.auth.uid != userId &&
        resource.data.role != 'ADMIN' && !grantsAdminPower(request.resource.data)
      )) || (
        // A signed-in user may rename themselves and manage their own push
        // notification tokens, but never touch the security-relevant fields
        // (role/branch/access/perms) on their own doc — otherwise any
        // account could grant itself admin rights.
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'fcmTokens', 'notificationPrefs', 'notificationChannels'])
      );
    }

    // Branches collection
    match /branches/{branchId} {
      allow read: if true; // Branches can be read by public (for complaint form)
      allow write: if canWriteSettings();
    }

    // Departments collection
    match /departments/{departmentId} {
      allow read: if true; // Departments can be read by public (for complaint form)
      allow write: if canWriteSettings();
    }

    // Editable classification lists (complaint types/sub-types, tech-support
    // problem types/platforms, lost&found item categories) — same posture as
    // branches/departments above: public read (used by parent-facing forms),
    // admin-only write.
    match /complaintTypes/{id} {
      allow read: if true;
      allow write: if canWriteSettings();
    }
    match /complaintSubTypes/{id} {
      allow read: if true;
      allow write: if canWriteSettings();
    }
    match /problemTypes/{id} {
      allow read: if true;
      allow write: if canWriteSettings();
    }
    match /platforms/{id} {
      allow read: if true;
      allow write: if canWriteSettings();
    }
    match /itemCategories/{id} {
      allow read: if true;
      allow write: if canWriteSettings();
    }

    // Misc system settings (e.g. editable WhatsApp message templates) —
    // staff need to read them to build outgoing messages, only an admin may
    // edit the wording.
    match /settings/{docId} {
      allow read: if isAuthenticated();
      // adminPermissions: owner only; security: Cloud Functions only.
      allow write: if docId == 'adminPermissions' ? isOwner() : (docId != 'security' && canWriteSettings());
    }
    // Settings password: unlocks are written by unlockSettings, the hash
    // (secureConfig) is never readable by clients.
    match /settingsUnlocks/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }
    match /secureConfig/{id} {
      allow read, write: if false;
    }

    // Complaints collection
    match /complaints/{complaintId} {
      // Public can read a specific complaint if they have the exact ID (Parent tracking).
      // NOTE: the parent-tracking portal itself looks complaints up by a
      // human-readable complaintId field, which Firestore treats as a `list`
      // (not `get`) — that path goes through the trackComplaint Cloud
      // Function (Admin SDK) instead of a direct client query, precisely so
      // `list` here can stay staff-only without breaking the public portal.
      allow get: if true;
      // Listing requires authentication AND being in scope of the branch —
      // callers must filter their query by `branch` for this to resolve.
      allow list: if isAuthenticated() && !isTripsOnly() && (isAdmin() || (
        inMyScope(resource.data.branch) &&
        (!isReceptionist() || resource.data.get('viaVisitQr', false) == true)
      ));
      // Creating complaints is allowed by public (via form) or authenticated staff
      allow create: if true;
      // Staff can update within their branch scope + edit permission; the
      // parent portal may additionally submit a survey/reopen while signed out.
      allow update: if (isAuthenticated() && canEditRecord(resource.data.branch)) || isParentPortalUpdate();
      allow delete: if isAuthenticated() && canDeleteRecord(resource.data.branch);

      // Activity log subcollection — treated as an append-only audit trail;
      // only admins may edit/remove entries after the fact.
      match /activityLog/{logId} {
        // Public read is required for parent tracking (ParentPortal); write is allowed
        // by public too since the parent-facing survey submission adds a log entry
        // while unauthenticated.
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }

      // Who opened the record (written by markRecordViewed only).
      match /views/{uid} {
        allow read: if isAuthenticated() && !isReceptionist() && !isTripsOnly();
        allow write: if false;
      }
    }

    // School trips — every write goes through Cloud Functions (saveTrip,
    // tripAction, submitTripConsent, reviewTripPayment, ...). Staff read the
    // trips of their branches; the per-student enrollments (health notes,
    // payment receipts) only those who manage, approve, finance or
    // supervise the trip.
    function tripInScope(trip) {
      let u = myDoc();
      return u != null && (
        u.get('access', 'branch') == 'all' ||
        trip.branches.hasAny(u.get('branches', [])) ||
        u.get('branch', null) in trip.branches ||
        request.auth.uid in trip.get('supervisors', [])
      );
    }
    function canSeeTripEnrollments(trip) {
      return isAdmin() || request.auth.uid in trip.get('supervisors', []) || (
        tripInScope(trip) &&
        (myPerm('trips') || myPerm('tripFinance') || myDoc().get('isPrincipal', false) == true)
      );
    }
    match /trips/{tripId} {
      allow get: if canSeeTrips() && (isAdmin() || tripInScope(resource.data));
      allow list: if isAdmin();
      allow write: if false;
      match /enrollments/{studentId} {
        allow read: if canSeeTrips() &&
          canSeeTripEnrollments(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if false;
      }
      // Parent surveys after the trip (submitTripSurvey).
      match /surveys/{studentId} {
        allow read: if canSeeTrips() &&
          canSeeTripEnrollments(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if false;
      }
      match /activityLog/{logId} {
        allow read: if canSeeTrips() &&
          (isAdmin() || tripInScope(get(/databases/$(database)/documents/trips/$(tripId)).data));
        allow write: if false;
      }
    }
    // Failed parent-verification counters (submitTripConsent) — server only.
    match /tripVerify/{id} {
      allow read, write: if false;
    }

    // School visit appointment bookings — written only by Cloud Functions.
    match /appointments/{id} {
      allow read: if isAuthenticated() && !isTripsOnly();
      allow write: if false;
    }

    // Deleted-complaints archive — a full snapshot is written here the
    // moment a complaint is deleted (see ComplaintDetails.jsx's handleDelete),
    // so nothing is ever truly gone without a trace. Admin-only read, per the
    // requirement that only the system admin can review what was deleted and
    // by whom; write is gated by the exact same permission the underlying
    // delete itself requires, so archiving never grants more than deleting
    // already did. Immutable once written — even an admin cannot edit or
    // remove an archive entry, matching the activityLog's append-only intent.
    match /deletedComplaints/{archiveId} {
      allow read: if adminPerm('archive');
      allow create: if isAuthenticated() && canDeleteRecord(request.resource.data.complaint.branch);
      allow update, delete: if false;
    }

    // Same archive-before-delete posture as deletedComplaints above, for
    // Lost & Found items (see LostFoundDetails.jsx's handleDelete) and
    // tech-support tickets (see TechSupportDetails.jsx's handleDelete).
    match /deletedLostFoundItems/{archiveId} {
      allow read: if adminPerm('archive');
      allow create: if isAuthenticated() && canDeleteRecord(request.resource.data.item.branch);
      allow update, delete: if false;
    }
    match /deletedTechSupportTickets/{archiveId} {
      allow read: if adminPerm('archive');
      allow create: if canAccessTechSupport() && canDeleteRecord(request.resource.data.ticket.branch);
      allow update, delete: if false;
    }

    // Lost & Found items collection
    match /lostFoundItems/{itemId} {
      allow get: if true;
      allow list: if isAuthenticated() && !isReceptionist() && !isTripsOnly() && (isAdmin() || inMyScope(resource.data.branch));
      allow create: if true;
      allow update: if (isAuthenticated() && canEditRecord(resource.data.branch)) ||
        isParentSurveyUpdate('RETURNED', ['CLOSED'], ['satisfactionRate', 'satisfactionDetails', 'parentFeedback', 'status', 'closedAt', 'updatedAt']);
      allow delete: if isAuthenticated() && canDeleteRecord(resource.data.branch);

      match /activityLog/{logId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Tech-support tickets — holds national IDs and is adjacent to a
    // credential-delivery workflow, so unlike complaints/lost-found this is
    // never publicly readable or creatable; staff must be signed in for
    // every operation, not just write. Further restricted via
    // canAccessTechSupport() to IT department staff, Customer Service (who
    // log the ticket when a parent calls in), and admins — this module is
    // not open to every signed-in employee the way complaints/lost-found are.
    match /techSupportTickets/{ticketId} {
      // Deliberately never publicly readable/writable (holds national IDs
      // and account credentials) — even the parent's satisfaction survey
      // goes through the submitTechSupportSurvey Cloud Function (Admin SDK)
      // instead of a narrow anonymous update rule like the other two
      // collections get, so this stays "staff must be signed in, no
      // exceptions" end to end.
      allow get: if canAccessTechSupport() && (isAdmin() || inMyScope(resource.data.branch));
      allow list: if canAccessTechSupport() && (isAdmin() || inMyScope(resource.data.branch));
      allow create: if canAccessTechSupport();
      allow update: if canAccessTechSupport() && canEditRecord(resource.data.branch);
      allow delete: if canAccessTechSupport() && canDeleteRecord(resource.data.branch);

      match /activityLog/{logId} {
        allow read, create: if canAccessTechSupport();
        allow update, delete: if isAdmin();
      }
      match /views/{uid} {
        allow read: if canAccessTechSupport();
        allow write: if false;
      }
    }

    // Student roster — read by any signed-in staff member so the
    // complaint/lost-found/tech-support forms can look a student up by
    // national ID or name and auto-fill the rest; only an admin may bulk
    // import/edit it (see Settings > import).
    match /students/{studentId} {
      allow read: if isAuthenticated() && !isReceptionist() && !isTripsOnly();
      allow write: if canWriteSettings();
    }

    // Notifications collection — created only by Cloud Functions (Admin SDK,
    // bypasses these rules). Clients may only read/update their own.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create, delete: if false;
    }

    // Other collections — admins only, and never the collections matched
    // explicitly above (rules OR together, so a blanket admin rule would
    // override their restrictions: archives, settings lock, owner account).
    match /{collection}/{document=**} {
      allow read, write: if isAdmin() && !(collection in [
        'users', 'branches', 'departments', 'complaintTypes', 'complaintSubTypes', 'problemTypes', 'platforms',
        'itemCategories', 'settings', 'settingsUnlocks', 'secureConfig', 'complaints', 'trips', 'tripVerify',
        'appointments', 'deletedComplaints', 'deletedLostFoundItems', 'deletedTechSupportTickets', 'lostFoundItems',
        'techSupportTickets', 'students', 'notifications'
      ]);
    }
  }
}
